;TYPE:Custom
;***** Snapmaker J1
;***** Update  : 20221222
;***** Printer : Snapmaker J1 0.4 (by ne0)
;***** Profile : 0.20mm NORMAL @J1 (by basepr1me)

; ----- bed_temperature_0: 65
; ----- bed_temperature_1: 65
; ----- extruder_temperature_0: 235
; ----- extruder_temperature_1: 235

; ----- initial_extruder: 0
; ----- is_extruder_used (0): true
; ----- is_extruder_used (1): false

M201 X20000 Y20000 Z500 E3000                       ;snapmaker settings
G28                                                 ;home

      ;------------OPTIONAL                
M355 S1 P16                                         ;dim led 


M82                                                 ;absolute extrusion mode
T0



  
    G1 X-5  F6000
    M104 S235 T0           ;preheat T0
    M190 S65 C3 W2    ;wait for bed temp

  


      ;-----------OPTIONAL                 ;led effect
  M355 S1 P32
  G4 S1
  M355 S1 P48
  G4 S1
  M355 S1 P64
  G4 S1
  M355 S1 P96
  G4 S1
  M355 S1 P128
  G4 S1
  M355 S1 P255


                                           ;purge line   -----------OPTIONAL    
  
    M109 S235 T0 C5 W1     ;wait for nozzle temp
    T0
    G1 Z0.8 Y-0.5 F1500                             ;move bed up fast
    G1 X50 F6000                                    ;position nozzle
    G1 Z0.4 F6000                                   ;set nozzle height
    G1 X163 E22.6 F1500                             ;purge 113mm line / 22.6mm filament in 1.5sec
          ;park
  

  G92 E0                                            ;reset extruder

  


;===== ready to go
G21 ; set units to millimeters
G90 ; use absolute coordinates
M83 ; use relative distances for extrusion
