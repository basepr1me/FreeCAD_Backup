; ----- bed_temperature_0: 65
; ----- bed_temperature_1: 65
; ----- extruder_temperature_0: 230
; ----- extruder_temperature_1: 230

; ----- initial_extruder: 0
; ----- is_extruder_used (0): true
; ----- is_extruder_used (1): true

M201 X20000 Y20000 Z500 E3000                       ;snapmaker settings
G28                                                 ;home

;------------OPTIONAL
M355 S1 P16                                         ;dim led

M82                                                 ;absolute extrusion mode
T0

T0
G1 X-5  F6000
M104 S230 T0             ;preheat T0

T1
G1 X332 F6000
M104 S230 T1             ;preheat T1

M190 S65 ;wait for bed temp

;-----------OPTIONAL                 ;led effect
M355 S1 P32
G4 S1
M355 S1 P48
G4 S1
M355 S1 P64
G4 S1
M355 S1 P96
G4 S1
M355 S1 P128
G4 S1
M355 S1 P255

;purge line   -----------OPTIONAL

M109 S230 T0 C5 W1     ;wait for nozzle temp
T0
G1 Z0.8 Y-0.5 F1500                             ;move bed up fast
G1 X50 F6000                                    ;position nozzle
G1 Z0.4 F6000                                   ;set nozzle height
G1 X163 E22.6 F1500                             ;purge 113mm line / 22.6mm filament in 1.5sec
G28 X F6000      ;park

G92 E0                                            ;reset extruder

M109 S230 T1 C5 W1     ;wait for nozzle temp
T1
G1 Z0.8 Y-0.5 F1500                             ;move bed up fast
G1 X276 F6000                                   ;position nozzle
G1 Z0.4 F6000                                   ;set nozzle height
G1 X163 E22.6 F1500                             ;purge 113mm line / 22.6mm filament in 1.5sec
G28 X F6000    ;park

;===== ready to go
G21 ; set units to millimeters
G90 ; use absolute coordinates
M83 ; use relative distances for extrusion
